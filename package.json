{
  "name": "ratamestari",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ratamestari/web dev",
    "build": "pnpm --filter @ratamestari/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "render-course": "tsx scripts/render-course.ts",
    "benchmark-courses": "tsx scripts/benchmark-courses.ts",
    "crop-ocad": "tsx scripts/crop-ocad.ts",
    "record-demo-run": "tsx scripts/record-demo-run.ts",
    "record-reel": "tsx scripts/record-reel.ts",
    "score-pdf": "tsx scripts/score-pdf.ts"
  },
  "devDependencies": {
    "@ratamestari/core": "workspace:*",
    "@ratamestari/engine": "workspace:*",
    "@ratamestari/iof": "workspace:*",
    "@ratamestari/map-import-ocad": "workspace:*",
    "@ratamestari/map-import-pdf": "workspace:*",
    "@ratamestari/print": "workspace:*",
    "@ratamestari/rules": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/xmldom": "^0.1.34",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "xmldom": "^0.6.0"
  }
}
